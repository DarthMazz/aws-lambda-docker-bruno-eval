# cp .env.example .env で使う。未作成の場合は compose.yaml の既定値が使われる。

# ホスト側に公開するポート（macOS は AirPlay レシーバーが 5000 を使うため moto は 5050）
MOTO_PORT=5050
REGISTER_ORDER_PORT=9000

# moto 上のリソース名
ORDERS_TABLE_NAME=Orders
ORDERS_BUCKET_NAME=orders-bucket

# ダミーの AWS 設定（実 AWS には接続しない）
AWS_DEFAULT_REGION=ap-northeast-1
